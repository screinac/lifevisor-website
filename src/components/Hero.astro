---
import { Image } from "astro:assets";
import homeScreenshot from "../assets/screenshots/home.png";
import StoreButtons from "./StoreButtons.astro";
---

<section id="download" class="w-full px-5 sm:px-8 pt-12 sm:pt-20 pb-14 sm:pb-20 overflow-x-clip">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_1fr] gap-16 lg:gap-12 items-center">
    <div class="fade-in">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-bg-card border border-line mb-8">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span class="text-sm font-medium text-ink-soft">Now on iPhone</span>
      </div>

      <h1 class="display text-[56px] sm:text-7xl lg:text-[88px] text-ink mb-8">
        Your time,<br /><b>in plain sight</b>
      </h1>

      <p class="text-lg sm:text-xl text-ink-soft/90 leading-relaxed mb-10 max-w-lg">
        Track what you do each day, set goals for your activities and see where your week
        really goes. Then let Luna tell you what she sees.
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <StoreButtons />
        <span class="flex items-center gap-2 text-sm text-muted-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/>
          </svg>
          Free · Pro with a 7-day trial
        </span>
      </div>
    </div>

    <div class="fade-in flex justify-center lg:justify-end lg:pr-10">
      <div class="relative">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] sm:w-[440px] sm:h-[440px] rounded-full bg-warm"></div>

        <div class="relative w-[250px] sm:w-[290px] rounded-[48px] bg-ink p-[9px] shadow-2xl">
          <div class="rounded-[40px] overflow-hidden aspect-[1206/2622] bg-bg">
            <Image src={homeScreenshot} alt="Life Visor home screen" loading="eager" class="w-full h-full object-cover" />
          </div>
        </div>

        <div class="absolute top-[7%] -left-8 sm:-left-20 flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-full bg-accent-bg text-accent shadow-sm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
          <span class="text-sm sm:text-base font-semibold tracking-tight">Work 4h</span>
        </div>

        <div class="absolute top-[62%] -right-6 sm:-right-16 flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-full bg-cool text-cool-ink shadow-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="text-sm sm:text-base font-semibold tracking-tight">Reading 1h 10m</span>
        </div>

        <div class="absolute bottom-[10%] -left-8 sm:-left-14 flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-full bg-bg-card border border-line shadow-md">
          <span class="w-3 h-3 rounded-full bg-peach-ink"></span>
          <span class="text-sm sm:text-base font-bold tracking-tight text-ink">+12 XP</span>
        </div>
      </div>
    </div>
  </div>
</section>
