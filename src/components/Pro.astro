---
const proFeatures = [
  "Luna's personalized analysis of your day and week",
  "Unlimited activities (free includes up to 5)",
  "Unlimited goals (free includes 1)",
  "Monthly view in Stats",
  "Export your sessions to CSV",
];
---

<section id="pro" class="w-full px-3 sm:px-8 py-10 sm:py-14">
  <div class="max-w-6xl mx-auto fade-in">
    <div class="bg-ink rounded-[36px] sm:rounded-[44px] px-6 py-12 sm:p-14 lg:p-20 text-white relative overflow-hidden">
      <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-cool/10 blur-3xl"></div>

      <div class="relative grid lg:grid-cols-[1.2fr_1fr] gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 mb-8">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="6"/><path d="M9 14L7.5 22 12 19.5 16.5 22 15 14"/>
            </svg>
            <span class="text-xs font-bold tracking-wider">PRO</span>
          </div>

          <h2 class="display text-5xl sm:text-6xl lg:text-[68px] mb-6">
            Unlock the <b>full experience</b>.<br />
            <span style="color:#F8ECBB">Free for 7 days.</span>
          </h2>

          <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-10 max-w-xl">
            Life Visor Pro gives you the complete tool, plus Luna's personalized analysis.
            Start with a 7-day free trial, then continue with a simple subscription — cancel anytime.
          </p>

          <a href="https://apps.apple.com/us/app/life-visor/id6759874795" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white text-ink text-sm font-semibold hover:bg-white/90 transition-colors">
            Get Life Visor
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>

        <ul class="rounded-3xl bg-white/[0.06] border border-white/10 p-6 sm:p-8 space-y-5">
          {proFeatures.map((feat) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-full bg-accent flex items-center justify-center mt-0.5 shrink-0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <span class="text-base sm:text-lg text-white/90">{feat}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
