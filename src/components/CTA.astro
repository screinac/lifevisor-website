---
import { Image } from "astro:assets";
import StoreButtons from "./StoreButtons.astro";
import appIcon from "../assets/app-icon.png";

---

<section class="w-full px-5 sm:px-8 py-14 sm:py-20">
  <div class="max-w-3xl mx-auto text-center fade-in">
    <Image src={appIcon} alt="Life Visor" width={72} height={72} class="rounded-2xl shadow-lg mx-auto mb-8" />

    <h2 class="display text-5xl sm:text-6xl text-ink mb-6">
      Start <b>today</b>.
    </h2>

    <p class="text-base sm:text-lg text-muted leading-relaxed mb-10 max-w-xl mx-auto">
      Free to use, with optional Pro for Luna's analysis, unlimited activities and goals,
      and monthly stats. Try Pro free for 7 days.
    </p>

    <div class="flex justify-center">
      <StoreButtons />
    </div>
  </div>
</section>
