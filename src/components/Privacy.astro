---
import { Image } from "astro:assets";
import lunaOutline from "../assets/luna/luna-outline.svg";

const rows = [
  {
    name: "Work",
    time: "8h",
    cls: "bg-accent-bg text-accent",
    icon: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
  },
  {
    name: "Reading",
    time: "30m",
    cls: "bg-info text-info-ink",
    icon: `<path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>`,
  },
  {
    name: "Exercise",
    time: "1h",
    cls: "bg-[#F6DEC4] text-[#835630]",
    icon: `<path d="M6.5 6.5 17.5 17.5"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>`,
  },
  {
    name: "Family",
    time: "2h",
    cls: "bg-warm text-warm-ink",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
];

const chips = [
  {
    label: "No ads",
    icon: `<circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>`,
    color: "#9B3B4A",
  },
  {
    label: "No selling",
    icon: `<path d="M12 2H2v10l9.29 9.29a1 1 0 0 0 1.41 0l8.59-8.59a1 1 0 0 0 0-1.41z"/><line x1="7" y1="7" x2="7.01" y2="7"/><line x1="3" y1="21" x2="21" y2="3"/>`,
    color: "#835630",
  },
  {
    label: "No accounts",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="22" y2="13"/><line x1="22" y1="8" x2="17" y2="13"/>`,
    color: "#255687",
  },
];
---

<section class="w-full px-5 sm:px-8 py-14 sm:py-20 overflow-x-clip">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.1fr] gap-16 lg:gap-12 items-center fade-in">
    <div>
      <span class="eyebrow text-muted-2 block mb-6">PRIVACY FIRST</span>

      <h2 class="display text-5xl sm:text-6xl lg:text-7xl text-ink mb-8">
        Your data is<br /><b>yours</b>
      </h2>

      <p class="text-lg sm:text-xl text-ink-soft/90 leading-relaxed mb-8 max-w-lg">
        Everything you log stays on your device — Luna only sees what you ask her to analyze.
        We don't sell your data, we don't show ads, and you don't need an account.
      </p>

      <div class="flex flex-wrap gap-3 mb-10">
        {chips.map((c) => (
          <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-bg-card border border-line text-base font-semibold text-ink">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={c.color} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            {c.label}
          </span>
        ))}
      </div>

      <a href="/privacy" class="inline-flex items-center gap-2 text-base font-semibold text-ink underline underline-offset-[6px] decoration-line decoration-2 hover:decoration-ink transition-colors">
        Read the full privacy policy
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-6 sm:gap-0" aria-hidden="true">
      <!-- Teléfono -->
      <div class="relative shrink-0">
        <div class="w-[290px] sm:w-[340px] rounded-[44px] bg-ink p-[11px] shadow-2xl">
          <div class="rounded-[34px] bg-white px-4 pt-4 pb-5">
            <div class="w-20 h-6 rounded-full bg-ink mx-auto mb-5"></div>
            <div class="space-y-3">
              {rows.map((r) => (
                <div class={`flex items-center justify-between rounded-2xl px-4 py-3.5 ${r.cls}`}>
                  <span class="flex items-center gap-2.5 text-base font-semibold">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
                    {r.name}
                  </span>
                  <span class="text-base font-bold">{r.time}</span>
                </div>
              ))}
            </div>
            <p class="flex items-center justify-center gap-2 text-sm text-muted-2 mt-5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
              </svg>
              Stored on this iPhone
            </p>
          </div>
        </div>

        <div class="absolute -top-4 -right-4 w-16 h-16 rounded-full bg-ink border-4 border-bg flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F8ECBB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
          </svg>
        </div>
      </div>

      <!-- Línea punteada hacia Luna -->
      <div class="flex sm:flex-col items-center gap-3 sm:gap-2">
        <div class="hidden sm:block w-28 lg:w-36 border-t-2 border-dashed border-muted-2/50"></div>
        <div class="sm:hidden h-10 border-l-2 border-dashed border-muted-2/50"></div>
        <span class="text-[11px] font-semibold tracking-[0.12em] uppercase text-muted-2 text-center leading-tight">Only what<br />you ask</span>
      </div>

      <!-- Luna -->
      <div class="flex flex-col items-center gap-2 shrink-0">
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-[#FBEBB5] overflow-hidden flex items-center justify-center">
          <Image src={lunaOutline} alt="" class="w-[94%] h-[94%]" />
        </div>
        <span class="text-sm font-bold text-ink">Luna</span>
      </div>
    </div>
  </div>
</section>
